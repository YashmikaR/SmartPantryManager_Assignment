<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pantry_background"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings &amp; Profile"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#222222" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="Personalise your Smart Pantry experience"
            android:textSize="14sp"
            android:textColor="#666666" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your profile"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/pantry_green" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Your name"
            android:textSize="15sp"
            android:textColor="#222222" />

        <EditText
            android:id="@+id/editProfileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="Enter your name"
            android:inputType="textPersonName"
            android:maxLength="50"
            android:singleLine="true"
            android:padding="12dp"
            android:backgroundTint="@color/pantry_blue" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="About"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/pantry_purple" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Smart Pantry Manager helps you track ingredients and discover recipes you can make with what you have."
            android:textSize="15sp"
            android:textColor="#666666"
            android:lineSpacingExtra="4dp" />

        <Button
            android:id="@+id/buttonSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Save profile"
            android:backgroundTint="@color/pantry_green"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/buttonCancelSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Back"
            android:backgroundTint="@color/pantry_blue"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</ScrollView>